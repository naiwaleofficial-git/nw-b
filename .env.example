# Copy this file to .env and fill in real values before running the server

NODE_ENV=development
PORT=5000

# MongoDB connection string (local or Atlas). If both are set, mongoURIAtlas is used.
mongoURIAtlas=
MONGO_URI=mongodb://127.0.0.1:27017/groombook?replicaSet=rs0
# Optional: comma separated DNS servers for Atlas SRV lookup trouble, e.g. 8.8.8.8,1.1.1.1
DNS_SERVERS=

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# OTP delivery: HTTPS endpoint accepting { phone, message } and returning 2xx.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Explicit local-only testing. Never enabled in production; the UI displays the test code.
OTP_DEVELOPMENT_MODE=false

# Razorpay (Phase 2 - optional, leave blank for MVP)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
